; --- thor : generated by Robot CNC (merge into the machine INI) ---

[TRAJ]
COORDINATES =                  X Y Z A B C
; World HOME = FK of the joint HOME values (machine coords)
HOME =                         207.945 -0.000 242.107 -180.000 -0.000 -180.000

[KINS]
KINEMATICS = genserkins coordinates=xyzabc
JOINTS =     6

[VTK]
MACHINE_PARTS = models/robot_thor.yml
TOOL_CYLINDER = robot
TOOL_GAUGE = 0
X = head
Y = head
Z = head
A = head
B = head
C = head

[EMCIO]
TOOL_CHANGE_POSITION = 207.945 -0.000 242.107 -180.000 -0.000 -180.000

[JOINT_0]
NAME =               A1
TYPE =               ANGULAR
MAX_VELOCITY =       360
MAX_ACCELERATION =   50000
MIN_LIMIT =          -720
MAX_LIMIT =          720
FERROR =             1.00
MIN_FERROR =         100
MAX_ERROR =          100
MAX_OUTPUT =         1.00
HOME =               0
HOME_OFFSET =        0
HOME_SEARCH_VEL =    0
HOME_LATCH_VEL =     0
HOME_USE_INDEX =     NO
HOME_ABSOLUTE_ENCODER = 1
HOME_SEQUENCE =      0

