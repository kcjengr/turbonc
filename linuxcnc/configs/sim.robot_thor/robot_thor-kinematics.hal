# Kinematic HAL config for the sim.robot_thor arm - AngelLM Thor, genserkins.
# Generated by models/gen_thor_config.py from models/thor_dh.py (modified DH).
#
# The genserkins joint coordinate is OFFSET from the physical URDF angle:
#     theta_j = q_physical + JOINT_OFFSET[j]
# because the DH frame convention adds a constant rotation at each joint.
# The LinuxCNC joint limits and HOME are shifted by the same offset; the
# Cartesian HOME below is the FK at the machine home.
#
# Joint offsets (deg): [0.0, 90.0, 90.0, 180.0, 180.0, 180.0]
# Machine home (deg):  [0.0, 85.0, 5.0, 180.0, 90.0, 180.0]
setp genserkins.max-iterations      0x000007d0
setp genserkins.ALPHA-0 0.000000000
setp genserkins.ALPHA-1 1.570796327
setp genserkins.ALPHA-2 0.000000000
setp genserkins.ALPHA-3 1.570796327
setp genserkins.ALPHA-4 1.570796327
setp genserkins.ALPHA-5 1.570796327
setp genserkins.A-0 0
setp genserkins.A-1 0
setp genserkins.A-2 160
setp genserkins.A-3 0
setp genserkins.A-4 0
setp genserkins.A-5 0
setp genserkins.D-0 202
setp genserkins.D-1 0
setp genserkins.D-2 0
setp genserkins.D-3 194
setp genserkins.D-4 0
setp genserkins.D-5 105.5
setp genserkins.unrotate-0 0
setp genserkins.unrotate-1 0
setp genserkins.unrotate-2 0
setp genserkins.unrotate-3 0
setp genserkins.unrotate-4 0
setp genserkins.unrotate-5 0