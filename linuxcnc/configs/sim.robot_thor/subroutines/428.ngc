%
;M428 by remap: select kinstype==0 (genserkins / cartesian-world)
o<428>sub
  #<kinstype> = 0

   G12.1 P#<kinstype>                   ; select kinstype 0, syncs interp and motion
                                        ; (no HAL pin / work-offset juggling needed)
o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M428: Wrong kinematics type)
     (debug,or switchable kinematics not available)
     M2
o2 endif

o<428>endsub
%
