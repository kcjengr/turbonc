# Kinematic HAL config file for the sim.robot arm - 6 DOF
#
#            j2     j3      j4     j5
#   j1   *-------*--------*--------*-------|end_effector|      (drawn pose)
#        |
#   L3   |
#        |
#   j0   *
#        |
#   L2   |
#        |
#   base *-------  table
#
# The DH parameters below are measured from models/robot_arm.yml / the STL
# assembly (which is the authoritative geometry) and re-authored onto the DH
# home frames (theta = 0: upper arm along +x, forearm hanging down):
#
#   J0 (0,0,76)   axis +Z      base yaw     d-0 = 186 (base -> shoulder)
#   J1 (0,0,186)  axis +Y      shoulder     alpha-1 = -90 (perpendicular)
#   J2 (224,0,186) axis +Y     elbow        a-2  = 224 (upper arm)
#   J3 (224,0,60)  axis -Z     forearm roll alpha-3 = -90, d-3 = 230 (forearm)
#   J4 (224,0,-44) axis +Y     wrist pitch  alpha-4 = +90
#   J5 (224,0,-120) axis -Z    tool roll    alpha-5 = -90, d-5 = 76 (flange)
#
# With this table the Jacobian is full rank 6 (sigma_min ~0.7 at generic
# poses). The machine HOME pose [0, -90, 0, 0, 10, 180] (see sim-robot_arm.ini)
# displays the arm in the classic drawn orientation, clear of the J4=0 wrist
# singularity.
setp genserkins.ALPHA-0 0
setp genserkins.ALPHA-1 -1.570796327
setp genserkins.ALPHA-2 0
setp genserkins.ALPHA-3 -1.570796327
setp genserkins.ALPHA-4 1.570796327
setp genserkins.ALPHA-5 -1.570796327

setp genserkins.A-0 0
setp genserkins.A-1 0
setp genserkins.A-2 224
setp genserkins.A-3 0
setp genserkins.A-4 0
setp genserkins.A-5 0

setp genserkins.D-0 186
setp genserkins.D-1 0
setp genserkins.D-2 0
setp genserkins.D-3 230
setp genserkins.D-4 0
# D-5 76 -> 164.15: the flange is 76mm below the wrist pitch, and the
# spindle's tool-exit face is another 88.15mm along the tool axis. The TCP
# (where the rendered tool sits) must be AT the spindle nose, so D-5 carries
# the full wrist->nose distance. The arm animation is unaffected (the
# relative M_cur @ inv(M_home) transform cancels d).
setp genserkins.D-5 164.15

setp genserkins.max-iterations      0x00000128
setp genserkins.unrotate-0 0
setp genserkins.unrotate-1 0
setp genserkins.unrotate-2 0
setp genserkins.unrotate-3 0
setp genserkins.unrotate-4 0
setp genserkins.unrotate-5 0
