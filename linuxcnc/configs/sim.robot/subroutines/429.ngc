%
;M429 by remap: select kinstype==1 (identity / joint)
o<429>sub
  #<kinstype> = 1

   G12.1 P#<kinstype>                   ; select identity kinematics, syncs interp and motion
o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M429: Wrong kinematics type)
     (debug,or switchable kinematics not available)
     M2
o2 endif

o<429>endsub
%
