
QMainWindow {
  background-color:#2d2d30;
  color:#353535;
}


QWidget{
  background:#2d2d30;
  color:#f1f1f1;
}

#estop_abutton{
  border-style:none;
  border-bottom:3px solid #FF0000;
  color:#f1f1f1;
  background:#3e3e42;
  padding:5px;
}


#estop_abutton:checked{
  border-bottom:3px solid #00ff00;
  background:#3e3e42;
}

#power_abutton{
  border-style:none;
  border-bottom:3px solid #007acc;
  color:#f1f1f1;
  background:#3e3e42;
  padding:5px;
}

#power_abutton:checked{
  border-bottom:3px solid #00FF00;
  background:#3e3e42;
}

#home_dbutton{
  border-style:none;
  border-bottom:3px solid #007acc;
  color:#f1f1f1;
  background:#3e3e42;
  padding:5px;
}

#home_dbutton:checked{
  border-bottom:3px solid #00FF00;
  background:#3e3e42;
}

QPushButton {
  border-style:none;
  border-bottom:3px solid #ff7300;
  color:#f1f1f1;
  background:#3e3e42;
  padding:5px;
}

QPushButton::pressed {
  border: 3px solid #007acc;
  background:#3e3e42;

}

QPushButton::disabled {
  border-bottom: 3px solid #C0C0C0;
  background:#3e3e42;
}

QPushButton::checked {
  border-bottom: 3px solid #00FF00;
  background:#3e3e42;
}



/*===========================================================================*/
/*                             tool and offset table                         */
/*===========================================================================*/

QHeaderView {
    font: 14pt;
    background-color: rgb(220, 220, 220);
    color: black;
    border: none;
}

ToolTable {
    border-top: 8px rgb(120, 120, 120);
    border-left: 4px  rgb(120, 120, 120);
    border-bottom: 5px rgb(120, 120, 120);
    border-right: 4px rgb(120, 120, 120);
    border-radius: 5px;
    border-color: rgb(120, 120, 120);
    border-style: solid;
    background-color: rgb(120, 120, 120);
    gridline-color: rgb(203, 203, 203);
    alternate-background-color: rgb(90, 90, 90);
    color: white;
    font: 15pt;
}

GCodeEditor {
    background-color: rgb(108, 108, 108);
    color: white;
    padding: 2px;
    font-family: "Probe Basic Bebas Mono";
    font-size: 13pt;
    font-style: normal;
    font-weight: 400;
    border-radius: 4px;

    qproperty-gCodeHighlightEnabled: false;
    qproperty-mCodeHighlightEnabled: false;
    qproperty-parameterHighlightEnabled: false;
    qproperty-numberHighlightEnabled: false;
    qproperty-commentHighlightEnabled: false;
    qproperty-stringHighlightEnabled: false;

    qproperty-gCodeColor: rgb(120, 180, 255);
    qproperty-mCodeColor: rgb(255, 150, 220);
    qproperty-parameterColor: rgb(140, 220, 140);
    qproperty-numberColor: rgb(255, 145, 145);
    qproperty-commentColor: rgb(150, 200, 150);
    qproperty-stringColor: rgb(130, 220, 220);

    qproperty-lineNumberAreaBackground: rgb(80, 80, 80);
    qproperty-lineNumberAreaColor: rgb(255, 255, 255);
    qproperty-lineNumberFontFamily: "Probe Basic Bebas Mono";
    qproperty-lineNumberFontPointSize: 11;
    qproperty-lineNumberFontWeight: 400;
    qproperty-lineNumberFontItalic: false;

    qproperty-currentLineHighlightEnabled: true;
    qproperty-currentLineBackground: rgb(108, 110, 240);
    qproperty-currentLineColor: rgb(255, 255, 255);
    qproperty-findHighlightBackground: rgb(40, 72, 185);
    qproperty-findHighlightText: rgb(255, 255, 255);
    qproperty-findErrorBackground: rgb(255, 0, 0);
    qproperty-findErrorText: rgb(255, 255, 255);
    qproperty-findStatusBackground: rgb(90, 90, 90);
    qproperty-findStatusText: rgb(255, 255, 255);
    qproperty-findStatusBorder: rgb(95, 95, 95);
}