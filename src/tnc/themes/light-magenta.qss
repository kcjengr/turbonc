/*===========================================================================*/
/*  TurBoNC — cyberpunk LIGHT theme (frosted light panels + neon edges)     */
/*===========================================================================*/

QWidget {
    background: transparent;
    color: #16222f;
}

QMainWindow {
    background-color: #f7eef5;
}

/* GCodeEditor is a QPlainTextEdit subclass — needs explicit styling */
QPlainTextEdit, GCodeEditor {
    background-color: #f3ddef;
    color: #16222f;
    selection-background-color: #ff2bd6;
    selection-color: #001418;
}

/*===========================================================================*/
/*  Buttons — dark chips with beveled cyber edges                            */
/*===========================================================================*/

QPushButton, QToolButton {
    border-style: solid;
    border-width: 1px;
    border-color: rgba(255, 43, 214, 150);
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(253, 244, 251, 170),
                                stop:0.5 rgba(251, 240, 249, 170),
                                stop:1 rgba(236, 214, 232, 190));
    color: #94197c;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton:hover, QToolButton:hover {
    border: 1px solid #ff2bd6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(250, 232, 247, 180),
                                stop:0.5 rgba(248, 228, 244, 180),
                                stop:1 rgba(230, 205, 225, 200));
    color: #0b0f14;
}

QPushButton:pressed, QToolButton:pressed {
    border: 1px solid #00e5ff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(228, 214, 225, 160),
                                stop:0.5 rgba(238, 214, 233, 160),
                                stop:1 rgba(244, 222, 240, 180));
    color: #9c2a76;
    padding-top: 7px;
    padding-bottom: 5px;
}

QPushButton:checked, QToolButton:checked {
    border: 1px solid #ff2bd6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff2bd6, stop:0.5 #ff17d2,
                                stop:1 #a50085);
    color: #001418;
    font-weight: 700;
}

QPushButton:disabled, QToolButton:disabled {
    border: 1px solid #ffc4f4;
    background: rgba(242, 228, 239, 160);
    color: #a47d9c;
}

/* Status toggles keep their neon accents over the dark chips */
#estop_abutton {
    border-style: solid;
    border-width: 1px;
    border-color: rgba(255, 43, 214, 150);
    border-bottom-width: 3px;
    border-bottom-color: #ff1744;
    color: #b0352c;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(250, 242, 244, 235),
                                stop:0.5 rgba(250, 238, 240, 235),
                                stop:1 rgba(224, 218, 222, 235));
    padding: 5px;
}

#estop_abutton:checked {
    border-bottom: 3px solid #00ff9d;
    color: #0d7a52;
}

#power_abutton {
    border-style: solid;
    border-width: 1px;
    border-color: rgba(255, 43, 214, 150);
    border-bottom-width: 3px;
    border-bottom-color: #ff2bd6;
    color: #16222f;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(253, 243, 251, 170),
                                stop:0.5 rgba(252, 242, 250, 170),
                                stop:1 rgba(232, 216, 229, 190));
    padding: 5px;
}

#power_abutton:checked {
    border-bottom: 3px solid #00ff9d;
    color: #0d7a52;
}

#home_dbutton {
    border-style: solid;
    border-width: 1px;
    border-color: rgba(255, 43, 214, 150);
    border-bottom-width: 3px;
    border-bottom-color: #ff2bd6;
    color: #16222f;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(253, 243, 251, 170),
                                stop:0.5 rgba(252, 242, 250, 170),
                                stop:1 rgba(232, 216, 229, 190));
    padding: 5px;
}

#home_dbutton:checked {
    border-bottom: 3px solid #00ff9d;
    color: #0d7a52;
}

/*===========================================================================*/
/*  Inputs                                                                    */
/*===========================================================================*/

QLineEdit {
    background: rgba(250, 238, 248, 235);
    border-style: solid;
    border-width: 1px;
    border-color: #b21e96;
    border-top-color: #ffa0ed;
    border-left-color: #ffa0ed;
    border-bottom-color: #9e1b85;
    border-right-color: #9e1b85;
    border-radius: 3px;
    padding: 3px 6px;
    color: #15202c;
    selection-background-color: #ff2bd6;
    selection-color: #001418;
}

QLineEdit:focus {
    border: 1px solid #ff2bd6;
}

QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(251, 240, 249, 170),
                                stop:1 rgba(236, 214, 232, 190));
    border-style: solid;
    border-width: 1px;
    border-color: #b21e96;
    border-top-color: #ffa0ed;
    border-left-color: #ffa0ed;
    border-bottom-color: #9e1b85;
    border-right-color: #9e1b85;
    border-radius: 3px;
    padding: 3px 8px;
    color: #94197c;
}

QComboBox:hover {
    border: 1px solid #ff2bd6;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: rgba(242, 222, 238, 240);
    color: #16222f;
    border: 1px solid #ff2bd6;
    selection-background-color: rgba(255, 43, 214, 60);
    selection-color: #0b0f14;
    outline: none;
}

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: rgba(244, 226, 241, 220);
    border: 1px solid #d123af;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background: #ff2bd6;
    border-color: #ff2bd6;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QRadioButton::indicator:checked {
    background: #ff2bd6;
    border-color: #ff2bd6;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(244, 226, 241, 220);
    border: 1px solid #d123af;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 20px;
    margin: -6px 0;
    border-radius: 4px;
    border: 1px solid #ff2bd6;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ff75e4, stop:1 #ff17d2);
}

QSlider::groove:vertical {
    width: 6px;
    background: rgba(244, 226, 241, 220);
    border: 1px solid #d123af;
    border-radius: 3px;
}

QSlider::handle:vertical {
    height: 20px;
    margin: 0 -6px;
    border-radius: 4px;
    border: 1px solid #ff2bd6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff75e4, stop:1 #ff17d2);
}

QSpinBox, QDoubleSpinBox {
    background: rgba(250, 238, 248, 235);
    border-style: solid;
    border-width: 1px;
    border-color: #b21e96;
    border-top-color: #ffa0ed;
    border-left-color: #ffa0ed;
    border-bottom-color: #9e1b85;
    border-right-color: #9e1b85;
    border-radius: 3px;
    padding: 2px 6px;
    color: #15202c;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #ff2bd6;
}

/*===========================================================================*/
/*  Panels — translucent with neon outlines                                  */
/*===========================================================================*/

QFrame {
    background: transparent;
}

QGroupBox {
    border: 1px solid rgba(255, 43, 214, 150);
    border-radius: 6px;
    margin-top: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(254, 246, 252, 205),
                                stop:0.5 rgba(254, 242, 252, 205),
                                stop:1 rgba(240, 222, 237, 215));
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 2px 8px;
    color: #ff2bd6;
    font-weight: 700;
    /* title chip follows the group box's own background so it blends in */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(254, 246, 252, 205),
                                stop:0.5 rgba(254, 242, 252, 205),
                                stop:1 rgba(240, 222, 237, 215));
    border: 1px solid rgba(255, 43, 214, 140);
    border-radius: 3px;
}

/* DRO readouts — dark glass chips */
DROLabel {
    background: rgba(252, 240, 250, 245);
    border: 1px solid rgba(255, 43, 214, 110);
    border-radius: 3px;
    padding: 2px 8px;
}

/*===========================================================================*/
/*  Tabs                                                                      */
/*===========================================================================*/

QTabWidget::pane {
    border: 1px solid #d123af;
    border-radius: 4px;
    background: rgba(244, 226, 241, 175);
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(251, 240, 249, 190),
                                stop:1 rgba(248, 233, 245, 190));
    border-style: solid;
    border-width: 1px;
    border-color: #b21e96;
    border-top-color: #ffa0ed;
    border-left-color: #ffa0ed;
    border-right-color: #9e1b85;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    color: #5a6f88;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    border: 1px solid #ff2bd6;
    border-bottom: none;
    color: #15202c;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff2bd6, stop:0.5 #ff17d2,
                                stop:1 #a50085);
    border: 1px solid #ff2bd6;
    border-bottom: none;
    color: #001418;
    font-weight: 700;
}

/*===========================================================================*/
/*  Tables                                                                    */
/*===========================================================================*/

QHeaderView {
    background: rgba(240, 218, 236, 220);
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(250, 230, 246, 240),
                                stop:1 rgba(244, 226, 241, 240));
    color: #94197c;
    border-style: solid;
    border-width: 1px;
    border-color: #b21e96;
    border-top-color: #ffa0ed;
    border-right-color: #d123af;
    border-bottom-color: #d123af;
    padding: 4px 8px;
    font-weight: 600;
}

/*===========================================================================*/
/*                             tool and offset table                         */
/*===========================================================================*/

ToolTable {
    border: 2px solid #d123af;
    border-top-color: #ffa0ed;
    border-radius: 5px;
    background-color: rgba(248, 232, 245, 248);
    gridline-color: #d123af;
    alternate-background-color: rgba(220, 230, 242, 230);
    color: #16222f;
    font: 15pt;
}

/*===========================================================================*/
/*  File system table                                                        */
/*===========================================================================*/

FileSystemTable {
    background-color: rgba(250, 238, 248, 245);
    alternate-background-color: rgba(224, 234, 246, 235);
    color: #16222f;
    border: 1px solid #d123af;
    border-top-color: #ffa0ed;
    border-radius: 4px;
    gridline-color: #d123af;
    selection-background-color: #ff2bd6;
    selection-color: #001418;
    font: 12pt "Bebas Kai";
}

FileSystemTable QHeaderView {
    font: 13pt "Bebas Kai";
}

GCodeEditor {
    background-color: #f3ddef;
    color: #16222f;
    padding: 2px;
    font-family: "Probe Basic Bebas Mono";
    font-size: 13pt;
    font-style: normal;
    font-weight: 400;
    border-radius: 4px;

    qproperty-syntaxHighlightingEnabled: true;

    /* Accent-token colors: the theme generator swaps these per accent so the
       editor chrome matches the selected theme (also applied in code at theme
       change, see MainWindow._apply_gcode_editor_theme). */
    qproperty-lineNumberAreaBackground: #f2e0ef;
    qproperty-lineNumberAreaColor: #ff2bd6;
    qproperty-lineNumberFontFamily: "Probe Basic Bebas Mono";
    qproperty-lineNumberFontPointSize: 11;
    qproperty-lineNumberFontWeight: 400;
    qproperty-lineNumberFontItalic: false;

    qproperty-currentLineHighlightEnabled: true;
    qproperty-currentLineBackground: #f2d2ec;
    qproperty-currentLineColor: #16222f;
    qproperty-findHighlightBackground: #ff17d2;
    qproperty-findHighlightText: #001418;
    qproperty-findErrorBackground: #8c1428;
    qproperty-findErrorText: #16222f;
    qproperty-findStatusBackground: #f4e4f1;
    qproperty-findStatusText: #94197c;
    qproperty-findStatusBorder: #c88fbd;
}

/*===========================================================================*/
/*  VTK backplot — gradient background follows the theme accent             */
/*===========================================================================*/

VTKBackPlot {
    qproperty-backgroundColor: #f3ddef;
    qproperty-backgroundColor2: #f7eef5;
}

/*===========================================================================*/
/*  Dialogs, menus, status bar — frosted, mostly-opaque with neon borders    */
/*===========================================================================*/

/* Frameless dialogs (Qt.FramelessWindowHint + WA_TranslucentBackground) paint
   their own frosted fill + neon border in paintEvent (Qt does not reliably
   draw the stylesheet background of a translucent top-level window). */

QMessageBox {
    background: rgba(250, 238, 248, 248);
}

QMenuBar {
    background: rgba(238, 216, 234, 248);
    color: #16222f;
    border-bottom: 1px solid #d123af;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background: rgba(255, 43, 214, 45);
    color: #0b0f14;
}

QMenu {
    background: rgba(250, 238, 248, 250);
    color: #16222f;
    border: 1px solid #ff2bd6;
}

QMenu::item {
    padding: 4px 24px;
    background: transparent;
}

QMenu::item:selected {
    background: rgba(255, 43, 214, 55);
    color: #0b0f14;
}

QMenu::separator {
    height: 1px;
    background: #d123af;
    margin: 4px 8px;
}

QStatusBar {
    background: rgba(238, 216, 234, 248);
    color: #5a6f88;
    border-top: 1px solid #d123af;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background: rgba(252, 240, 250, 252);
    color: #15202c;
    border: 1px solid #ff2bd6;
    padding: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 43, 214, 110);
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #ff2bd6;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 43, 214, 110);
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #ff2bd6;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
