/*===========================================================================*/
/*  TurBoNC view style — GLOW                                               */
/*  Thick accent borders, saturated fills and strong hover glow.            */
/*===========================================================================*/

QPushButton, QToolButton {
    border: 2px solid rgba(@main_rgb@, 190);
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 55),
                                stop:0.5 rgba(@bevel_top_rgb@, 180),
                                stop:1 rgba(@bevel_bottom_rgb@, 200));
    color: @text_bright@;
    padding: 5px 11px;
    font-weight: 700;
}

QPushButton:hover, QToolButton:hover {
    border: 2px solid @main@;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 95),
                                stop:0.5 rgba(@bevel_top_rgb@, 190),
                                stop:1 rgba(@bevel_bottom_rgb@, 210));
    color: #ffffff;
}

QPushButton:pressed, QToolButton:pressed {
    border: 2px solid @pressed@;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@pressed_rgb@, 90),
                                stop:1 rgba(@bevel_bottom_rgb@, 210));
    color: #ffffff;
    padding-top: 6px;
    padding-bottom: 4px;
}

QPushButton:checked, QToolButton:checked {
    border: 2px solid @main@;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @light@, stop:0.5 @main@,
                                stop:1 @deep@);
    color: @on_accent@;
    font-weight: 800;
}

QPushButton:disabled, QToolButton:disabled {
    border: 2px solid @border_disabled@;
    background: rgba(@bevel_bottom_rgb@, 200);
    color: @border_disabled@;
}

/* Status toggles keep their safety accents, with the glow treatment */
#estop_abutton {
    border: 2px solid rgba(@main_rgb@, 190);
    border-bottom: 3px solid #ff1744;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@bevel_top_rgb@, 235),
                                stop:1 rgba(@bevel_bottom_rgb@, 235));
    color: #ffd9d9;
    padding: 4px;
}

#estop_abutton:checked {
    border-bottom: 3px solid #00ff9d;
    color: #c9ffe9;
}

#power_abutton, #home_dbutton {
    border: 2px solid rgba(@main_rgb@, 190);
    border-bottom: 3px solid @power@;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@bevel_top_rgb@, 235),
                                stop:1 rgba(@bevel_bottom_rgb@, 235));
    color: @text@;
    padding: 4px;
}

#power_abutton:checked, #home_dbutton:checked {
    border-bottom: 3px solid #00ff9d;
    color: #c9ffe9;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    border: 2px solid rgba(@main_rgb@, 140);
    border-radius: 4px;
    background: rgba(@bevel_bottom_rgb@, 240);
    padding: 2px 6px;
    color: @text@;
    selection-background-color: @main@;
    selection-color: @on_accent@;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid @main@;
}

QComboBox {
    border: 2px solid rgba(@main_rgb@, 140);
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 40),
                                stop:1 rgba(@bevel_bottom_rgb@, 210));
    padding: 2px 8px;
    color: @text_bright@;
}

QComboBox:hover {
    border: 2px solid @main@;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: rgba(@bevel_bottom_rgb@, 245);
    color: @text@;
    border: 2px solid @main@;
    selection-background-color: rgba(@main_rgb@, 80);
    selection-color: #ffffff;
    outline: none;
}

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: rgba(@bevel_bottom_rgb@, 240);
    border: 2px solid rgba(@main_rgb@, 150);
    border-radius: 3px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @main@;
    border-color: @main@;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(@bevel_bottom_rgb@, 240);
    border: 1px solid @border_line@;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 20px;
    margin: -6px 0;
    border-radius: 4px;
    border: 2px solid @main@;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @light@, stop:1 @mid@);
}

QSlider::groove:vertical {
    width: 6px;
    background: rgba(@bevel_bottom_rgb@, 240);
    border: 1px solid @border_line@;
    border-radius: 3px;
}

QSlider::handle:vertical {
    height: 20px;
    margin: 0 -6px;
    border-radius: 4px;
    border: 2px solid @main@;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @light@, stop:1 @mid@);
}

QFrame {
    background: transparent;
}

QGroupBox {
    border: 2px solid rgba(@main_rgb@, 200);
    border-radius: 8px;
    margin-top: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 30),
                                stop:0.5 rgba(@bevel_top_rgb@, 190),
                                stop:1 rgba(@bevel_bottom_rgb@, 210));
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: @main@;
    font-weight: 800;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 30),
                                stop:0.5 rgba(@bevel_top_rgb@, 190),
                                stop:1 rgba(@bevel_bottom_rgb@, 210));
}

DROLabel {
    background: rgba(@bevel_bottom_rgb@, 245);
    border: 1px solid rgba(@main_rgb@, 140);
    border-radius: 3px;
    padding: 2px 8px;
}

QTabWidget::pane {
    border: 2px solid rgba(@main_rgb@, 130);
    border-radius: 4px;
    background: rgba(@bevel_bottom_rgb@, 240);
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 40),
                                stop:1 rgba(@bevel_bottom_rgb@, 200));
    border: 2px solid rgba(@main_rgb@, 130);
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    color: @text_tint@;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    border: 2px solid @main@;
    border-bottom: none;
    color: #ffffff;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @light@, stop:0.5 @main@,
                                stop:1 @deep@);
    border: 2px solid @main@;
    border-bottom: none;
    color: @on_accent@;
    font-weight: 800;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(@main_rgb@, 35),
                                stop:1 rgba(@bevel_bottom_rgb@, 240));
    color: @text@;
    border-style: solid;
    border-width: 1px;
    border-color: @border_line@;
    border-top-color: rgba(@main_rgb@, 130);
    border-right-color: @border_line@;
    border-bottom-color: @border_line@;
    padding: 4px 8px;
    font-weight: 600;
}

ToolTable {
    border: 2px solid rgba(@main_rgb@, 130);
    border-radius: 5px;
    background-color: rgba(@bevel_bottom_rgb@, 248);
    gridline-color: @border_line@;
    alternate-background-color: rgba(@bevel_top_rgb@, 230);
    color: @text@;
}

FileSystemTable {
    background-color: rgba(@bevel_bottom_rgb@, 245);
    alternate-background-color: rgba(@bevel_top_rgb@, 235);
    color: @text@;
    border: 2px solid rgba(@main_rgb@, 130);
    border-radius: 4px;
    gridline-color: @border_line@;
    selection-background-color: @main@;
    selection-color: @on_accent@;
}

QMenuBar {
    background: rgba(@bevel_bottom_rgb@, 248);
    color: @text@;
    border-bottom: 2px solid rgba(@main_rgb@, 130);
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background: rgba(@main_rgb@, 55);
    color: #ffffff;
}

QMenu {
    background: rgba(@bevel_bottom_rgb@, 250);
    color: @text@;
    border: 2px solid @main@;
}

QMenu::item {
    padding: 4px 24px;
    background: transparent;
}

QMenu::item:selected {
    background: rgba(@main_rgb@, 70);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: @border_line@;
    margin: 4px 8px;
}

QMessageBox {
    background: rgba(@bevel_bottom_rgb@, 248);
}

QStatusBar {
    background: rgba(@bevel_bottom_rgb@, 248);
    color: @text_tint@;
    border-top: 2px solid rgba(@main_rgb@, 130);
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background: rgba(@bevel_bottom_rgb@, 252);
    color: #ffffff;
    border: 2px solid @main@;
    padding: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(@main_rgb@, 160);
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: @main@;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(@main_rgb@, 160);
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: @main@;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
